import {
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/core/debug",
  "mizchi/similarity" @lib,
  "moonbitlang/x/fs",
  "moonbitlang/x/encoding",
  "moonbitlang/async",
  "moonbitlang/async/process",
}

pkgtype(kind: "executable")

options(
  targets: {
    "main.mbt": [ "native" ],
    "main_js.mbt": [ "js", "wasm", "wasm-gc" ],
  },
)
